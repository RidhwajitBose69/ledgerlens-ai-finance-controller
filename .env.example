# LedgerLens Environment Configuration

MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ledgerlens
LOG_LEVEL=INFO

# AI Provider Credentials (Optional - Defaults to MockAIProvider)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Razorpay Gateway Credentials (Optional - Defaults to Mock Gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Safety Policy Thresholds
AUTO_RESOLUTION_THRESHOLD=0.95
MAX_AUTO_RESOLUTION_AMOUNT_PAISE=10000000
